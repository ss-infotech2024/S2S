MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/
# Database name (defaults to "test", the database the project has always used)
MONGODB_DB=test
# Must match VITE_ADMIN_TOKEN in admin/.env
ADMIN_TOKEN=replace-with-a-long-random-string
PORT=8787

# Extra allowed browser origins, comma separated (localhost/127.0.0.1 on 8080 and 5173-5176 are always allowed)
CORS_ORIGINS=
# Deployed website and admin URLs (also added to the CORS allowlist)
STUDENT_PORTAL_URL=http://localhost:8080
ADMIN_PORTAL_URL=

# Session cookie: use SameSite=None (sent with Secure) only when website and API are on different sites over HTTPS
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false

# Website enrollments are emailed here (default hr@ssinfotech.co.in)
HR_NOTIFICATION_EMAIL=hr@ssinfotech.co.in

# Needed to email HR enrollment notifications and password-setup links
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# LMS uploads (lesson resources, assignment files) are stored on disk, not in MongoDB
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=5
UPLOAD_ALLOWED_TYPES=pdf,doc,docx,ppt,pptx,xls,xlsx,txt,zip,png,jpg,jpeg

# Default certificate signatory (a course's own signatory in its Content settings takes priority)
CERT_SIGNATORY_NAME=
CERT_SIGNATORY_TITLE=
